# Cognee-OpenSpec Configuration
# This .env file is specific to cognee-openspec and loads before the cognee submodule's .env

# Backend settings
ENABLE_BACKEND_ACCESS_CONTROL=false
LOG_LEVEL=ERROR
REQUIRE_AUTHENTICATION=false
TELEMETRY_DISABLED=1

# Use local directory for persistence (not in /tmp)
SYSTEM_ROOT_DIRECTORY=/nfs/site/disks/hfeng1_fw_01/coder/adk-python/cognee-openspec/.cognee_system
DATA_ROOT_DIRECTORY=/nfs/site/disks/hfeng1_fw_01/coder/adk-python/cognee-openspec/.cognee_data

# Rate limiting for API calls
# Balanced setting - 30 RPM avoids rate limit errors while maintaining reasonable speed
EMBEDDING_RATE_LIMIT_ENABLED=true
EMBEDDING_RATE_LIMIT_REQUESTS=30
EMBEDDING_RATE_LIMIT_INTERVAL=60

LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=30
LLM_RATE_LIMIT_INTERVAL=60

# LLM Configuration
# GitHub Copilot (active)
LLM_MODEL=github_copilot/gpt-4o
LLM_PROVIDER=custom
LLM_API_KEY=oauth2
EMBEDDING_MODEL=github_copilot/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Alternative Options (commented out):
# Option 1: OpenAI
# LLM_API_KEY=sk-your-openai-api-key
# LLM_MODEL=openai/gpt-4o
# LLM_PROVIDER=openai

# Option 2: iflow (Alibaba Cloud)
# LLM_API_KEY=your-iflow-api-key
# LLM_MODEL=dashscope/qwen3-coder-plus
# LLM_ENDPOINT=https://apis.iflow.cn/v1/
# LLM_PROVIDER=custom

# target to build an object file
toy-risc-core.c.o:
	cd /home/hfeng1/demo/rag/simics-project/bt && $(MAKE) $(MAKESILENT) -f pkgs/sample-risc/CMakeFiles/sample-risc.dir/build.make pkgs/sample-risc/CMakeFiles/sample-risc.dir/toy-risc-core.c.o
.PHONY : toy-risc-core.c.o


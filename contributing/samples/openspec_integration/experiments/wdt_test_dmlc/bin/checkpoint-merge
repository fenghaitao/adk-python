#!/bin/bash
# this file will be overwritten by the project setup script
SIMICS_BASE_PACKAGE="/home/coder/.simics-mcp-server/simics-install/simics-7.57.0"
export SIMICS_BASE_PACKAGE
export SIMICS_PYTHON_PACKAGE="/home/coder/.simics-mcp-server/simics-install/simics-7.57.0/scripts/../../simics-python-7.13.0/linux64/bin/../.."
if [ -z "${SIMICS_PYTHON}" ]; then
    _DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
    export SIMICS_PYTHON=""
fi
if [ -f "/home/coder/ai_agents/tests/wdt_test_dmlc/.package-list" ]; then
    exec "/home/coder/.simics-mcp-server/simics-install/simics-7.57.0/bin/checkpoint-merge" --package-list "/home/coder/ai_agents/tests/wdt_test_dmlc/.package-list" --project "/home/coder/ai_agents/tests/wdt_test_dmlc" "$@"
else
    exec "/home/coder/.simics-mcp-server/simics-install/simics-7.57.0/bin/checkpoint-merge" --project "/home/coder/ai_agents/tests/wdt_test_dmlc" "$@"
fi

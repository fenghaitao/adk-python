// Register implementations with side effects
// Bank: watchdog_memap
bank watchdog_memap {
    register WDOGLOAD {
        method write_register(uint64 value, uint64 enabled_bytes, void *aux) {
            log info, 1: ">>> WDOGLOAD write_register() CALLED with value=0x%x", value;

            // Call default write behavior first
            default(value, enabled_bytes, aux);

            // Side effect: Store the reload value for the watchdog timer
            // This value will be used to reload the counter when:
            // 1. INTEN bit transitions from 0 to 1 in WDOGCONTROL
            // 2. WDOGINTCLR is written (clears interrupt and reloads counter)
            // The actual reload logic is implemented in those respective registers

            log info, 1: ">>> WDOGLOAD updated, reload_value=0x%x", this.val;
        }
    }

    register WDOGVALUE {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            log info, 1: ">>> WDOGVALUE read_register() CALLED";

            // TODO: Implement read-only register logic for WDOGVALUE
            // Description: Watchdog Value Register - Current counter value
            // Fields:
            //   - count_read: [31:0] - Current value of watchdog counter
            // TODO: Return the current register value or computed value

            return this.val;
        }
    }

    register WDOGCONTROL {
        method write_register(uint64 value, uint64 enabled_bytes, void *aux) {
            log info, 1: ">>> WDOGCONTROL write_register() CALLED with value=0x%x", value;

            // Call default write behavior first
            default(value, enabled_bytes, aux);

            // TODO: Implement side effects for WDOGCONTROL
            // Description: Watchdog Control Register
            // Fields:
            //   - RESERVED: [31:5] - Reserved bits
            //   - step_value: [4:2] - Step value for counter decrement
            //   - RESEN: [1:1] - Enable watchdog reset output
            //   - INTEN: [0:0] - Enable watchdog interrupt
            // TODO: Add your implementation here

            log info, 1: ">>> WDOGCONTROL updated, value=0x%x", this.val;
        }
    }

    register WDOGINTCLR {
        method write_register(uint64 value, uint64 enabled_bytes, void *aux) {
            log info, 1: ">>> WDOGINTCLR write_register() CALLED with value=0x%x", value;

            // Call default write behavior first
            default(value, enabled_bytes, aux);

            // TODO: Implement side effects for WDOGINTCLR
            // Description: Watchdog Interrupt Clear Register
            // Fields:
            //   - intclr: [31:0] - Writing any value clears the interrupt and reloads counter from WDOGLOAD
            // TODO: Add your implementation here

            log info, 1: ">>> WDOGINTCLR updated, value=0x%x", this.val;
        }
    }

    register WDOGRIS {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            log info, 1: ">>> WDOGRIS read_register() CALLED";

            // TODO: Implement read-only register logic for WDOGRIS
            // Description: Watchdog Raw Interrupt Status Register
            // Fields:
            //   - RESERVED: [31:1] - Reserved bits
            //   - raw_watchdog_int: [0:0] - Raw interrupt status from the counter (WS0)
            // TODO: Return the current register value or computed value

            return this.val;
        }
    }

    register WDOGMIS {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            log info, 1: ">>> WDOGMIS read_register() CALLED";

            // TODO: Implement read-only register logic for WDOGMIS
            // Description: Watchdog Masked Interrupt Status Register (WDOGRIS & INTEN)
            // Fields:
            //   - RESERVED: [31:1] - Reserved bits
            //   - watchdog_int: [0:0] - Masked interrupt status (WDOGRIS & INTEN)
            // TODO: Return the current register value or computed value

            return this.val;
        }
    }

    register WDOGLOCK {
        method write_register(uint64 value, uint64 enabled_bytes, void *aux) {
            log info, 1: ">>> WDOGLOCK write_register() CALLED with value=0x%x", value;

            // Call default write behavior first
            default(value, enabled_bytes, aux);

            // TODO: Implement side effects for WDOGLOCK
            // Description: Watchdog Lock Register
            // Fields:
            //   - wdog_lock: [31:0] - Register write access control. Write 0x1ACCE551 to enable write access, any other value to disable.
            // TODO: Add your implementation here

            log info, 1: ">>> WDOGLOCK updated, value=0x%x", this.val;
        }
    }

    register WDOGPERIPHID0 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            log info, 1: ">>> WDOGPERIPHID0 read_register() CALLED";

            // TODO: Implement read-only register logic for WDOGPERIPHID0
            // Description: Peripheral ID Register 0
            // Fields:
            //   - periph_id0: [7:0] - Part number bits [7:0]
            // TODO: Return the current register value or computed value

            return this.val;
        }
    }

    register WDOGPCELLID0 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            log info, 1: ">>> WDOGPCELLID0 read_register() CALLED";

            // TODO: Implement read-only register logic for WDOGPCELLID0
            // Description: PrimeCell ID Register 0
            // Fields:
            //   - pcell_id0: [7:0] - PrimeCell ID bits [7:0]
            // TODO: Return the current register value or computed value

            return this.val;
        }
    }

dml 1.4;

device test_ddm_lib;

param desc = "test device for ddm-lib";

import "test-ddm-lib-dia.dml";
import "test-ddm-lib-glue.dml";

extern void ASSERT_FMT(bool, const char *, ...);

template test_attr is write_only_attr {
    param type = "n";

    shared method test();
    method set(attr_value_t val) throws {
        test();
    }
}

dml 1.4;

import "simics/devs/signal.dml";
import "cmn-common.dml";
import "hnf-600.dml";
import "hni-600.dml";
import "rnsam-600.dml";

is cmn_device;

attribute map_with_offset "Legacy attribute, not used" {
    param internal = true;
    param configuration = "pseudo";
    param type default "a";
    method set(attr_value_t val) throws default { }
    method get() -> (attr_value_t) default { return SIM_make_attr_nil(); }
}

attribute reset_asserted "Legacy attribute, not used" {
    param internal = true;
    param type = "b";
    param configuration = "pseudo";
    method set(attr_value_t val) throws {
        HRESET.signal.high = SIM_attr_boolean(val);
    }
    method get() -> (attr_value_t) {
        return SIM_make_attr_boolean(HRESET.signal.high);
    }
}

attribute periphbase {
    param length = 0x4000000;  // 64MB
}

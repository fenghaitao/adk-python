static inline ipxact_dia_t *
__new_ipxact_dia(bytes_t data, uint64 expected_hash)
{
  ipxact_dia_t *ret = MM_MALLOC(1, ipxact_dia_t);
  const uint8 *mapped = data.data;
  uint64 size = data.len;
  ASSERT(size >= 8);
  uint64 hash = UNALIGNED_LOAD_LE64(mapped);
  FATAL_ERROR_IF(hash != expected_hash, "Glue and generated binary out-of-sync");
  int64 pos = 8;
  ASSERT(sizeof(_ipxact_dia_sizes_t) <= size);
  memcpy(&ret->sz, mapped + pos, sizeof(_ipxact_dia_sizes_t));
  pos += sizeof(_ipxact_dia_sizes_t);
  pos = (pos + 7) & ~7;
  ret->bank = (const _ipxact_dia_bank_t *)(mapped + pos);
  pos += sizeof(*ret->bank) * ret->sz.bank;
  pos = (pos + 7) & ~7;
  ret->reg = (const _ipxact_dia_reg_t *)(mapped + pos);
  pos += sizeof(*ret->reg) * ret->sz.reg;
  pos = (pos + 7) & ~7;
  ret->field = (const _ipxact_dia_field_t *)(mapped + pos);
  pos += sizeof(*ret->field) * ret->sz.field;
  pos = (pos + 7) & ~7;
  ret->field_group = (const _ipxact_dia_field_group_t *)(mapped + pos);
  pos += sizeof(*ret->field_group) * ret->sz.field_group;
  pos = (pos + 7) & ~7;
  ret->reg_group = (const _ipxact_dia_reg_group_t *)(mapped + pos);
  pos += sizeof(*ret->reg_group) * ret->sz.reg_group;
  pos = (pos + 7) & ~7;
  ret->handles = (const _ipxact_dia_handles_t *)(mapped + pos);
  pos += sizeof(*ret->handles) * ret->sz.handles;
  pos = (pos + 7) & ~7;
  ret->string_pool = (const char *)(mapped + pos);
  pos += sizeof(char) * ret->sz.string_pool;
  pos = (pos + 7) & ~7;
  ret->uint32_pool = (const uint32 *)(mapped + pos);
  pos += sizeof(uint32) * ret->sz.uint32_pool;
  pos = (pos + 7) & ~7;
  FATAL_ERROR_IF(pos != size,
      "unexpected datablob size: expected %lld, got %lld",
      pos, size);
  return ret;
}


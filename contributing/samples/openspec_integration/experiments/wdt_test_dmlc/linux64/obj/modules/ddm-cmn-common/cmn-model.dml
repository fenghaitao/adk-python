dml 1.4;

header %{
#include <simics/base/types.h>
#include <simics/util/alloc.h>
#include <simics/util/help-macros.h>
#include <simics/util/swabber.h>
typedef struct { uint32 idx; } cmn_bank_t;
typedef struct { uint32 idx; } cmn_reg_t;
typedef struct { uint32 idx; } cmn_field_t;
typedef struct { uint32 idx; } cmn_handles_t;
typedef struct {
  uint32 bank;
  uint32 reg;
  uint32 field;
  uint32 handles;
  uint32 string_pool;
  uint32 uint32_pool;
} _cmn_sizes_t;
typedef struct {
  uint32 regs_size;
  uint32 regs_first_pool_idx;
} _cmn_bank_t;
typedef struct {
  uint64 offset;
  uint64 init_val;
  uint64 field_bits;
  uint32 bank;
  uint32 name_pool_idx;
  uint32 fields_first_pool_idx;
  uint32 desc_pool_idx;
  uint8 fields_size;
  uint8 size;
  uint8 _bits[1];
} _cmn_reg_t;
typedef struct {
  uint64 lock_value;
  uint32 reg;
  uint32 name_pool_idx;
  uint32 desc_pool_idx;
  uint32 lock_ref_first_pool_idx;
  uint8 lsb;
  uint8 bitsize;
  uint8 lock_ref_size;
  uint8 _bits[1];
} _cmn_field_t;
typedef struct {
  uint32 bank_size;
  uint32 bank_first_pool_idx;
  uint32 reg_size;
  uint32 reg_first_pool_idx;
  uint32 field_size;
  uint32 field_first_pool_idx;
} _cmn_handles_t;
typedef struct {
  _cmn_sizes_t sz;
  const _cmn_bank_t *bank;
  const _cmn_reg_t *reg;
  const _cmn_field_t *field;
  const _cmn_handles_t *handles;
  const char *string_pool;
  const uint32 *uint32_pool;
} cmn_t;
static inline cmn_bank_t
cmn__mk__bank(uint32 i)
{
  return (cmn_bank_t){i};
}

static inline uint32
cmn__id__bank(cmn_bank_t i)
{
  return i.idx;
}

static inline cmn_reg_t
cmn__mk__reg(uint32 i)
{
  return (cmn_reg_t){i};
}

static inline uint32
cmn__id__reg(cmn_reg_t i)
{
  return i.idx;
}

static inline cmn_field_t
cmn__mk__field(uint32 i)
{
  return (cmn_field_t){i};
}

static inline uint32
cmn__id__field(cmn_field_t i)
{
  return i.idx;
}

static inline cmn_handles_t
cmn__mk__handles(uint32 i)
{
  return (cmn_handles_t){i};
}

static inline uint32
cmn__id__handles(cmn_handles_t i)
{
  return i.idx;
}

static inline uint32
cmn__num__bank(const cmn_t *_indep)
{
  return _indep->sz.bank;
}

static inline uint32
cmn_bank_regs_len(const cmn_t *_indep, cmn_bank_t bank)
{
  return _indep->bank[bank.idx].regs_size;
}

static inline cmn_reg_t
cmn_bank_regs_item(const cmn_t *_indep, cmn_bank_t bank, uint32 index)
{
  FATAL_ERROR_IF(index >=_indep->bank[bank.idx].regs_size, "index %u out-of-bounds in list of size %u", index, _indep->bank[bank.idx].regs_size);
  return cmn__mk__reg(_indep->uint32_pool[_indep->bank[bank.idx].regs_first_pool_idx + index]);
}

static inline uint32
cmn__num__reg(const cmn_t *_indep)
{
  return _indep->sz.reg;
}

static inline cmn_bank_t
cmn_reg_bank(const cmn_t *_indep, cmn_reg_t reg)

{
  return (cmn_bank_t){.idx=_indep->reg[reg.idx].bank};
}

static inline uint64
cmn_reg_offset(const cmn_t *_indep, cmn_reg_t reg)

{
  return _indep->reg[reg.idx].offset;
}

static inline uint64
cmn_reg_init_val(const cmn_t *_indep, cmn_reg_t reg)

{
  return _indep->reg[reg.idx].init_val;
}

static inline uint64
cmn_reg_field_bits(const cmn_t *_indep, cmn_reg_t reg)

{
  return _indep->reg[reg.idx].field_bits;
}

static inline bool
cmn_reg_read_only(const cmn_t *_indep, cmn_reg_t reg)
{
  return (_indep->reg[reg.idx]._bits[0] & 1) != 0;
}

static inline const char *
cmn_reg_name(const cmn_t *_indep, cmn_reg_t reg)
{
  return &_indep->string_pool[_indep->reg[reg.idx].name_pool_idx];
}

static inline uint8
cmn_reg_fields_len(const cmn_t *_indep, cmn_reg_t reg)
{
  return _indep->reg[reg.idx].fields_size;
}

static inline cmn_field_t
cmn_reg_fields_item(const cmn_t *_indep, cmn_reg_t reg, uint8 index)
{
  FATAL_ERROR_IF(index >=_indep->reg[reg.idx].fields_size, "index %u out-of-bounds in list of size %u", index, _indep->reg[reg.idx].fields_size);
  return cmn__mk__field(_indep->uint32_pool[_indep->reg[reg.idx].fields_first_pool_idx + index]);
}

static inline uint8
cmn_reg_size(const cmn_t *_indep, cmn_reg_t reg)

{
  return _indep->reg[reg.idx].size;
}

static inline const char *
cmn_reg_desc(const cmn_t *_indep, cmn_reg_t reg)
{
  return &_indep->string_pool[_indep->reg[reg.idx].desc_pool_idx];
}

static inline uint32
cmn__num__field(const cmn_t *_indep)
{
  return _indep->sz.field;
}

static inline cmn_reg_t
cmn_field_reg(const cmn_t *_indep, cmn_field_t field)

{
  return (cmn_reg_t){.idx=_indep->field[field.idx].reg};
}

static inline uint8
cmn_field_lsb(const cmn_t *_indep, cmn_field_t field)

{
  return _indep->field[field.idx].lsb;
}

static inline uint8
cmn_field_bitsize(const cmn_t *_indep, cmn_field_t field)

{
  return _indep->field[field.idx].bitsize;
}

static inline bool
cmn_field_read_only(const cmn_t *_indep, cmn_field_t field)
{
  return (_indep->field[field.idx]._bits[0] & 1) != 0;
}

static inline const char *
cmn_field_name(const cmn_t *_indep, cmn_field_t field)
{
  return &_indep->string_pool[_indep->field[field.idx].name_pool_idx];
}

static inline const char *
cmn_field_desc(const cmn_t *_indep, cmn_field_t field)
{
  return &_indep->string_pool[_indep->field[field.idx].desc_pool_idx];
}

static inline uint8
cmn_field_lock_ref_len(const cmn_t *_indep, cmn_field_t field)
{
  return _indep->field[field.idx].lock_ref_size;
}

static inline cmn_field_t
cmn_field_lock_ref_item(const cmn_t *_indep, cmn_field_t field, uint8 index)
{
  FATAL_ERROR_IF(index >=_indep->field[field.idx].lock_ref_size, "index %u out-of-bounds in list of size %u", index, _indep->field[field.idx].lock_ref_size);
  return cmn__mk__field(_indep->uint32_pool[_indep->field[field.idx].lock_ref_first_pool_idx + index]);
}

static inline uint64
cmn_field_lock_value(const cmn_t *_indep, cmn_field_t field)

{
  return _indep->field[field.idx].lock_value;
}

static inline uint32
cmn__num__handles(const cmn_t *_indep)
{
  return _indep->sz.handles;
}

static inline uint32
cmn_handles_bank_len(const cmn_t *_indep, cmn_handles_t handles)
{
  return _indep->handles[handles.idx].bank_size;
}

static inline cmn_bank_t
cmn_handles_bank_item(const cmn_t *_indep, cmn_handles_t handles, uint32 index)
{
  FATAL_ERROR_IF(index >=_indep->handles[handles.idx].bank_size, "index %u out-of-bounds in list of size %u", index, _indep->handles[handles.idx].bank_size);
  return cmn__mk__bank(_indep->uint32_pool[_indep->handles[handles.idx].bank_first_pool_idx + index]);
}

static inline uint32
cmn_handles_reg_len(const cmn_t *_indep, cmn_handles_t handles)
{
  return _indep->handles[handles.idx].reg_size;
}

static inline cmn_reg_t
cmn_handles_reg_item(const cmn_t *_indep, cmn_handles_t handles, uint32 index)
{
  FATAL_ERROR_IF(index >=_indep->handles[handles.idx].reg_size, "index %u out-of-bounds in list of size %u", index, _indep->handles[handles.idx].reg_size);
  return cmn__mk__reg(_indep->uint32_pool[_indep->handles[handles.idx].reg_first_pool_idx + index]);
}

static inline uint32
cmn_handles_field_len(const cmn_t *_indep, cmn_handles_t handles)
{
  return _indep->handles[handles.idx].field_size;
}

static inline cmn_field_t
cmn_handles_field_item(const cmn_t *_indep, cmn_handles_t handles, uint32 index)
{
  FATAL_ERROR_IF(index >=_indep->handles[handles.idx].field_size, "index %u out-of-bounds in list of size %u", index, _indep->handles[handles.idx].field_size);
  return cmn__mk__field(_indep->uint32_pool[_indep->handles[handles.idx].field_first_pool_idx + index]);
}

static inline cmn_t *
__new_cmn(bytes_t data, uint64 expected_hash)
{
  cmn_t *ret = MM_MALLOC(1, cmn_t);
  const uint8 *mapped = data.data;
  uint64 size = data.len;
  ASSERT(size >= 8);
  uint64 hash = UNALIGNED_LOAD_LE64(mapped);
  FATAL_ERROR_IF(hash != expected_hash, "Glue and generated binary out-of-sync");
  int64 pos = 8;
  ASSERT(sizeof(_cmn_sizes_t) <= size);
  memcpy(&ret->sz, mapped + pos, sizeof(_cmn_sizes_t));
  pos += sizeof(_cmn_sizes_t);
  pos = (pos + 7) & ~7;
  ret->bank = (const _cmn_bank_t *)(mapped + pos);
  pos += sizeof(*ret->bank) * ret->sz.bank;
  pos = (pos + 7) & ~7;
  ret->reg = (const _cmn_reg_t *)(mapped + pos);
  pos += sizeof(*ret->reg) * ret->sz.reg;
  pos = (pos + 7) & ~7;
  ret->field = (const _cmn_field_t *)(mapped + pos);
  pos += sizeof(*ret->field) * ret->sz.field;
  pos = (pos + 7) & ~7;
  ret->handles = (const _cmn_handles_t *)(mapped + pos);
  pos += sizeof(*ret->handles) * ret->sz.handles;
  pos = (pos + 7) & ~7;
  ret->string_pool = (const char *)(mapped + pos);
  pos += sizeof(char) * ret->sz.string_pool;
  pos = (pos + 7) & ~7;
  ret->uint32_pool = (const uint32 *)(mapped + pos);
  pos += sizeof(uint32) * ret->sz.uint32_pool;
  pos = (pos + 7) & ~7;
  FATAL_ERROR_IF(pos != size,
      "unexpected datablob size: expected %lld, got %lld",
      pos, size);
  return ret;
}

%}


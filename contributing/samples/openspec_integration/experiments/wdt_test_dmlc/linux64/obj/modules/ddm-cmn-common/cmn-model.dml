group cmn is ddm_dialect_base {
  param spec_type_carrier = *cast(NULL, cmn_t *);
  param _new_spec = __new_cmn;
  param assoc_vtable_type_carrier = *cast(NULL, cmn_assoc_vtable *);
  param each_dia_bank_expr = each cmn_assoc_to_bank in (dev);
  param bank_type_carrier = *cast(NULL, cmn_bank_t *);
  param bank_template_carrier = *cast(NULL, cmn_assoc_to_bank *);
  group bank is cmn_dialect_base_bank;
  param reg_type_carrier = *cast(NULL, cmn_reg_t *);
  group reg is cmn_dialect_base_reg;
  param field_type_carrier = *cast(NULL, cmn_field_t *);
  group field is cmn_dialect_base_field;
  param handles_type_carrier = *cast(NULL, cmn_handles_t *);
  group handles is cmn_dialect_base_handles;
}
template cmn_dialect_base_bank is ddm_dialect_base_bank {
  param __count = cmn__num__bank;
  param __id   = cmn__id__bank;
  param __mk   = cmn__mk__bank;
  param _regs_item = cmn_bank_regs_item;
  param _regs_len = cmn_bank_regs_len;
  independent method regs_len(cmn_bank_t _bank) -> (uint32) default {
    return this._regs_len(dia.spec(), _bank);
  }
  independent method regs_item(cmn_bank_t _bank, uint32 _i) -> (cmn_reg_t) default {
    return this._regs_item(dia.spec(), _bank, _i);
  }

  independent startup memoized method _assoc_ht() -> (ht_int_table_t) {
    local ht_int_table_t ret;
    ht_init_int_table(&ret);
    foreach assoc in (each cmn_assoc_to_bank in (dev)) {
        local cmn_assoc_to_bank *entry = new cmn_assoc_to_bank;
        *entry = assoc;
        ht_insert_int(&ret, this.__id(entry->ddm_bank()), entry);
    }
    return ret;
  }

  independent method get_assoc(cmn_bank_t item) -> (cmn_assoc_to_bank) throws {
    local ht_int_table_t ht = _assoc_ht();
    local cmn_assoc_to_bank *assoc = ht_lookup_int(&ht, this.__id(item));
    if (assoc == NULL) throw;
    return *assoc;
  }
}
template cmn_dialect_base_reg is ddm_dialect_base_reg {
  param __count = cmn__num__reg;
  param __id   = cmn__id__reg;
  param __mk   = cmn__mk__reg;
  param _bank = cmn_reg_bank;
  independent method bank(cmn_reg_t _reg) -> (cmn_bank_t) default {
    return this._bank(dia.spec(), _reg);
  }
  param _offset = cmn_reg_offset;
  independent method offset(cmn_reg_t _reg) -> (uint64) default {
    return this._offset(dia.spec(), _reg);
  }
  param _init_val = cmn_reg_init_val;
  independent method init_val(cmn_reg_t _reg) -> (uint64) default {
    return this._init_val(dia.spec(), _reg);
  }
  param _field_bits = cmn_reg_field_bits;
  independent method field_bits(cmn_reg_t _reg) -> (uint64) default {
    return this._field_bits(dia.spec(), _reg);
  }
  param _read_only = cmn_reg_read_only;
  independent method read_only(cmn_reg_t _reg) -> (bool) default {
    return this._read_only(dia.spec(), _reg);
  }
  param _name_ = cmn_reg_name;
  independent method name_(cmn_reg_t _reg) -> (const char *) default {
    return this._name_(dia.spec(), _reg);
  }
  param _fields_item = cmn_reg_fields_item;
  param _fields_len = cmn_reg_fields_len;
  independent method fields_len(cmn_reg_t _reg) -> (uint32) default {
    return this._fields_len(dia.spec(), _reg);
  }
  independent method fields_item(cmn_reg_t _reg, uint32 _i) -> (cmn_field_t) default {
    return this._fields_item(dia.spec(), _reg, _i);
  }
  param _size = cmn_reg_size;
  independent method size(cmn_reg_t _reg) -> (uint8) default {
    return this._size(dia.spec(), _reg);
  }
  param _desc_ = cmn_reg_desc;
  independent method desc_(cmn_reg_t _reg) -> (const char *) default {
    return this._desc_(dia.spec(), _reg);
  }

  independent startup memoized method _assoc_ht() -> (ht_int_table_t) {
    local ht_int_table_t ret;
    ht_init_int_table(&ret);
    foreach assoc in (each cmn_assoc_to_reg in (dev)) {
        local cmn_assoc_to_reg *entry = new cmn_assoc_to_reg;
        *entry = assoc;
        ht_insert_int(&ret, this.__id(entry->ddm_reg()), entry);
    }
    return ret;
  }

  independent method get_assoc(cmn_reg_t item) -> (cmn_assoc_to_reg) throws {
    local ht_int_table_t ht = _assoc_ht();
    local cmn_assoc_to_reg *assoc = ht_lookup_int(&ht, this.__id(item));
    if (assoc == NULL) throw;
    return *assoc;
  }
}
template cmn_dialect_base_field is ddm_dialect_base_field {
  param __count = cmn__num__field;
  param __id   = cmn__id__field;
  param __mk   = cmn__mk__field;
  param _reg = cmn_field_reg;
  independent method reg(cmn_field_t _field) -> (cmn_reg_t) default {
    return this._reg(dia.spec(), _field);
  }
  param _lsb = cmn_field_lsb;
  independent method lsb(cmn_field_t _field) -> (uint8) default {
    return this._lsb(dia.spec(), _field);
  }
  param _bitsize = cmn_field_bitsize;
  independent method bitsize(cmn_field_t _field) -> (uint8) default {
    return this._bitsize(dia.spec(), _field);
  }
  param _read_only = cmn_field_read_only;
  independent method read_only(cmn_field_t _field) -> (bool) default {
    return this._read_only(dia.spec(), _field);
  }
  param _name_ = cmn_field_name;
  independent method name_(cmn_field_t _field) -> (const char *) default {
    return this._name_(dia.spec(), _field);
  }
  param _desc_ = cmn_field_desc;
  independent method desc_(cmn_field_t _field) -> (const char *) default {
    return this._desc_(dia.spec(), _field);
  }
  param _lock_ref_item = cmn_field_lock_ref_item;
  param _lock_ref_len = cmn_field_lock_ref_len;
  independent method lock_ref_len(cmn_field_t _field) -> (uint32) default {
    return this._lock_ref_len(dia.spec(), _field);
  }
  independent method lock_ref_item(cmn_field_t _field, uint32 _i) -> (cmn_field_t) default {
    return this._lock_ref_item(dia.spec(), _field, _i);
  }
  param _lock_value = cmn_field_lock_value;
  independent method lock_value(cmn_field_t _field) -> (uint64) default {
    return this._lock_value(dia.spec(), _field);
  }

  independent startup memoized method _assoc_ht() -> (ht_int_table_t) {
    local ht_int_table_t ret;
    ht_init_int_table(&ret);
    foreach assoc in (each cmn_assoc_to_field in (dev)) {
        local cmn_assoc_to_field *entry = new cmn_assoc_to_field;
        *entry = assoc;
        ht_insert_int(&ret, this.__id(entry->ddm_field()), entry);
    }
    return ret;
  }

  independent method get_assoc(cmn_field_t item) -> (cmn_assoc_to_field) throws {
    local ht_int_table_t ht = _assoc_ht();
    local cmn_assoc_to_field *assoc = ht_lookup_int(&ht, this.__id(item));
    if (assoc == NULL) throw;
    return *assoc;
  }
}
template cmn_dialect_base_handles is ddm_dialect_base_handles {
  param __count = cmn__num__handles;
  param __id   = cmn__id__handles;
  param __mk   = cmn__mk__handles;
  param _bank_item = cmn_handles_bank_item;
  param _bank_len = cmn_handles_bank_len;
  independent method bank_len(cmn_handles_t _handles) -> (uint32) default {
    return this._bank_len(dia.spec(), _handles);
  }
  independent method bank_item(cmn_handles_t _handles, uint32 _i) -> (cmn_bank_t) default {
    return this._bank_item(dia.spec(), _handles, _i);
  }
  param _reg_item = cmn_handles_reg_item;
  param _reg_len = cmn_handles_reg_len;
  independent method reg_len(cmn_handles_t _handles) -> (uint32) default {
    return this._reg_len(dia.spec(), _handles);
  }
  independent method reg_item(cmn_handles_t _handles, uint32 _i) -> (cmn_reg_t) default {
    return this._reg_item(dia.spec(), _handles, _i);
  }
  param _field_item = cmn_handles_field_item;
  param _field_len = cmn_handles_field_len;
  independent method field_len(cmn_handles_t _handles) -> (uint32) default {
    return this._field_len(dia.spec(), _handles);
  }
  independent method field_item(cmn_handles_t _handles, uint32 _i) -> (cmn_field_t) default {
    return this._field_item(dia.spec(), _handles, _i);
  }

}


template _cmn_assoc_vtable_downcast_impl is cmn_assoc_vtable {
  shared independent method _ddm_assoc_vtable_downcast() -> (_traitref_t) {
    local cmn_assoc_vtable ref = cast(this, cmn_assoc_vtable);
    return *cast(&ref, _traitref_t *);
  }
}

in each cmn_assoc_vtable { is _cmn_assoc_vtable_downcast_impl; }

template cmn_assoc_to_field_base is ddm_assoc_to_field {
  param dia = dev.cmn;
  shared independent method ddm_field() -> (cmn_field_t) {
    local cmn_assoc_to_field_base assoc = this;
    return cmn.handles._field_item(dev.cmn.spec(),
        cmn.handles.__mk(0),
        assoc.first_field_index
        + cast(&assoc, _traitref_t *)->id.encoded_index);
  }
}
in each cmn_assoc_to_field { is cmn_assoc_to_field_base; }
template cmn_assoc_to_bank_base is ddm_assoc_to_bank {
  param dia = dev.cmn;

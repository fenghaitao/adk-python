    local cmn_assoc_to_bank_base assoc = this;
    return cmn.handles._bank_item(dev.cmn.spec(),
        cmn.handles.__mk(0),
        assoc.first_bank_index
        + cast(&assoc, _traitref_t *)->id.encoded_index);
  }
  in each ddm_assoc_vtable { is _cmn_assoc_vtable_downcast_impl; }

  shared method little_endian_byte_order(cmn_reg_t reg) -> (bool);

  shared method validate_reg_write_impl(cmn_reg_t reg,
                                        uint64 curr_val, uint64 written_val,
                                        uint64 enabled_bits, void *aux)
                                    -> (uint64);
  shared method validate_reg_read_impl(cmn_reg_t reg, uint64 curr_val,
                                       uint64 enabled_bits, void *aux)
                                   -> (uint64);

  shared method reg_write_impl(cmn_reg_t reg, uint64 curr_val,
                               uint64 written_val, uint64 enabled_bits,
                               void *aux) -> (uint64);

  shared method reg_read_impl(cmn_reg_t reg, uint64 curr_val,
                              uint64 enabled_bits, void *aux) -> (uint64);
}
in each cmn_assoc_to_bank { is cmn_assoc_to_bank_base; }

  uint32 regs_first_pool_idx;
} _cmn_bank_t;
extern typedef struct {
  uint64 offset;
  uint64 init_val;
  uint64 field_bits;
  uint32 bank;
  uint32 name_pool_idx;
  uint32 fields_first_pool_idx;
  uint32 desc_pool_idx;
  uint8 fields_size;
  uint8 size;
  uint8 _bits[1];
} _cmn_reg_t;

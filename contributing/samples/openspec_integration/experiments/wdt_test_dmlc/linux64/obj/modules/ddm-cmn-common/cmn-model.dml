extern typedef struct { uint32 idx; } cmn_reg_t;
extern typedef struct { uint32 idx; } cmn_field_t;
extern typedef struct { uint32 idx; } cmn_handles_t;
extern typedef struct {
  uint32 bank;
  uint32 reg;
  uint32 field;
  uint32 handles;
  uint32 string_pool;
  uint32 uint32_pool;
} _cmn_sizes_t;
extern typedef struct {

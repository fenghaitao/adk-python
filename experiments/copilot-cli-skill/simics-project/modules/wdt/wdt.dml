// Event object for timeout handling
event timeout_event is simple_cycle_event {
    // Timeout event callback handler
    method event() {
        // Skip timeout actions in test mode
        if (dev.test_mode) {
            return;
        }
        
        local uint64 ctrl_val = dev.wdt_map.WDOGCONTROL.val;
        local uint64 inten = ctrl_val & 0x1;
        local uint64 resen = (ctrl_val >> 1) & 0x1;
        
        if (!dev.interrupt_pending) {
            // First timeout: Generate interrupt
            dev.wdt_map.WDOGRIS.val = 1;
            if (dev.WDOGINT.obj) {
                dev.WDOGINT.signal.signal_raise();
            }
            dev.interrupt_pending = true;
            log info: "First timeout - interrupt asserted";
            
            // Reload counter
            dev.counter_start_value = cast(dev.wdt_map.WDOGLOAD.val, uint32);
            dev.counter_start_time = SIM_cycle_count(dev.obj);
            
            // Reschedule if timer still enabled
            if (inten != 0) {
                dev.schedule_timeout(dev.counter_start_value);
            }
        } else {
            // Second timeout: Generate reset if enabled
            if (resen != 0) {
                if (dev.WDOGRES.obj) {
                    dev.WDOGRES.signal.signal_raise();
                }
                log warning: "Second timeout - reset asserted";
            } else {
                // Continue interrupt-only mode
                log info: "Second timeout - interrupt continues (RESEN=0)";
                // Reload counter
                dev.counter_start_value = cast(dev.wdt_map.WDOGLOAD.val, uint32);
                dev.counter_start_time = SIM_cycle_count(dev.obj);
                
                // Reschedule if timer still enabled
                if (inten != 0) {
                    dev.schedule_timeout(dev.counter_start_value);
                }
            }
        }
    }
}

// Helper method: Calculate current counter value using lazy evaluation
method calculate_counter_value() -> (uint32) {
    // If in test mode, counter is static
    if (test_mode) {
        return counter_start_value;
    }
    
    // Check if timer is enabled (INTEN=1)
    local uint64 ctrl_val = dev.wdt_map.WDOGCONTROL.val;
    local uint64 inten = ctrl_val & 0x1;
    
    // If timer disabled, return saved counter value
    if (inten == 0) {
        return counter_start_value;
    }
    
    if (counter_start_value == 0) {
        return 0;
    }
    local uint64 current_time = SIM_cycle_count(dev.obj);
    local uint64 elapsed_cycles = current_time - counter_start_time;
    
    if (elapsed_cycles >= counter_start_value) {
        return 0;  // Counter expired
    }
    return cast(counter_start_value - elapsed_cycles, uint32);
}

// Helper method: Schedule timeout event
method schedule_timeout(uint32 cycles) {
    if (dev.timeout_event.posted()) {
        dev.timeout_event.remove();
    }
    // Schedule with minimum 1 cycle (zero load value should timeout immediately)
    local uint32 event_cycles = (cycles == 0) ? 1 : cycles;
    dev.timeout_event.post(event_cycles);
    log info: "Timeout event scheduled for %d cycles", event_cycles;
}

// Helper method: Stop timer
method stop_timer() {
    if (dev.timeout_event.posted()) {
        dev.timeout_event.remove();
    }
    // Preserve current counter value by calculating it before stopping
    // We must calculate manually here to avoid circular dependency
    local uint64 current_time = SIM_cycle_count(dev.obj);
    local uint64 elapsed_cycles = current_time - counter_start_time;
    if (elapsed_cycles >= counter_start_value) {
        counter_start_value = 0;
    } else {
        counter_start_value = cast(counter_start_value - elapsed_cycles, uint32);
    }
    // Update start time to current to freeze the counter
    counter_start_time = current_time;
    log info: "Timer stopped, counter value preserved: %d", counter_start_value;
}


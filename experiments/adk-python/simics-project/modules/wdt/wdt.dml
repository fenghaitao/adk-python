dml 1.4;
device wdt;
import "wdt-registers.dml";
import "simics/devs/signal.dml";

// Saved state variables for the watchdog timer
saved bool locked = true;           // Default locked state
saved bool inten = false;           // Interrupt enable state
saved bool resen = false;           // Reset enable state
saved uint32 step_value = 0;        // Clock divider value
saved bool int_pending = false;     // Interrupt pending state
saved bool reset_pending = false;   // Reset pending state
saved bool test_mode = false;       // Integration test mode state
saved uint32 test_output = 0;       // Test output values

// Timer tracking variables
saved cycles_t last_update_time = 0;
saved uint32 current_counter_value = 0xffffffff;
saved bool timer_enabled = false;
saved bool timer_expired = false;

// Event for handling watchdog timeout
event timeout_event is simple_cycle_event {
    method event() {
        // Timer has expired
        timer_expired = true;
        
        // Set raw interrupt status
        int_pending = true;
        WatchdogRegisters.WDOGRIS.RAW_WDOG_INT.set(1);
        
        // Update masked interrupt status
        update_masked_interrupt();
        
        // Raise interrupt if enabled
        if (inten) {
            wdogint.signal.signal_raise();
        }
        
        // If reset is enabled, also assert the reset signal
        if (resen && inten) {
            wdogres.signal.signal_raise();
            reset_pending = true;
        }
    }
    
    method schedule_timeout(uint32 counter_val) {
        if (posted()) {
            remove();
        }
        
        if (counter_val > 0) {
            // Calculate the number of cycles to wait based on step_value
            // Apply the clock divider to determine actual timeout cycles
            local uint32 divider;
            switch (step_value) {
                case 0: divider = 1; break;   // ÷1
                case 1: divider = 2; break;   // ÷2
                case 2: divider = 4; break;   // ÷4
                case 3: divider = 8; break;   // ÷8
                case 4: divider = 16; break;  // ÷16
                default: divider = 1; break;  // Invalid values treated as ÷1
            }
            
            local cycles_t timeout_cycles = cast(counter_val, cycles_t) * cast(divider, cycles_t);
            post(timeout_cycles);
        }
    }
    
    method cancel() {
        if (posted()) {
            remove();
        }
    }
}

// Update masked interrupt status based on raw status and INTEN
method update_masked_interrupt() {
    local uint32 raw_int = WatchdogRegisters.WDOGRIS.RAW_WDOG_INT.val;
    local uint32 masked_int = raw_int & (inten ? 1 : 0);
    WatchdogRegisters.WDOGMIS.WDOG_INT.set(masked_int);
}

// Calculate current counter value using lazy evaluation
method calculate_current_counter() -> (uint32) {
    if (!timer_enabled || test_mode) {
        // In test mode or when disabled, return the current stored value
        return current_counter_value;
    }
    
    local cycles_t now = SIM_cycle_count(dev.obj);
    local cycles_t elapsed_cycles = now - last_update_time;
    
    // Calculate how much the counter should have decremented
    local uint32 divider;
    switch (step_value) {
        case 0: divider = 1; break;   // ÷1
        case 1: divider = 2; break;   // ÷2
        case 2: divider = 4; break;   // ÷4
        case 3: divider = 8; break;   // ÷8
        case 4: divider = 16; break;  // ÷16
        default: divider = 1; break;  // Invalid values treated as ÷1
    }
    
    // Calculate effective elapsed counter ticks based on divider
    local uint32 elapsed_ticks = cast(elapsed_cycles / cast(divider, cycles_t), uint32);
    
    if (current_counter_value > elapsed_ticks) {
        // Calculate new value
        local uint32 new_value = current_counter_value - elapsed_ticks;
        if (timer_expired) {
            // Timer already expired, keep at zero
            return 0;
        }
        return new_value;
    } else {
        // Counter has reached zero or gone negative, return 0
        return 0;
    }
}

// Reload the counter and schedule timeout event
method reload_counter(uint32 new_value) {
    current_counter_value = new_value;
    last_update_time = SIM_cycle_count(dev.obj);
    
    // Cancel any pending timeout event
    timeout_event.cancel();
    timer_expired = false;
    timer_enabled = inten;  // Enable timer only if INTEN is set
    
    if (timer_enabled && new_value > 0) {
        timeout_event.schedule_timeout(new_value);
    }
}

// Clear the interrupt and reload the counter
method clear_interrupt_and_reload() {
    // Clear interrupt pending status
    int_pending = false;
    reset_pending = false;
    WatchdogRegisters.WDOGRIS.RAW_WDOG_INT.set(0);
    update_masked_interrupt();
    
    // Lower the interrupt and reset signals if they were raised
    wdogint.signal.signal_lower();
    wdogres.signal.signal_lower();
    
    // Reload counter from WDOGLOAD
    local uint32 load_value = WatchdogRegisters.WDOGLOAD.WDOG_LOAD.val;
    reload_counter(load_value);
}

bank WatchdogRegisters is WatchdogRegisters_temp {
    register WDOGLOAD {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (!locked) {
                // Update the register field value
                default(val, enabled_bytes, aux);
                
                // If INTEN was previously disabled and is now enabled, reload counter
                if (inten && timer_enabled != inten) {
                    reload_counter(this.WDOG_LOAD.val);
                }
            }
            // If locked, ignore the write
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGVALUE {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            // Use lazy evaluation to calculate current counter value
            local uint32 current_val = calculate_current_counter();
            return cast(current_val, uint64);
        }
    }
    
    register WDOGCONTROL {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (!locked) {
                // Get the old INTEN value before updating
                local bool old_inten = inten;
                
                // Apply the write to register fields first
                default(val, enabled_bytes, aux);
                
                // Update internal state variables based on the new field values
                inten = (this.INTEN.val != 0) ? true : false;
                resen = (this.RESEN.val != 0) ? true : false;
                step_value = cast(this.STEP_VALUE.val, uint32);
                
                // Check if INTEN changed from 0 to 1
                if (!old_inten && inten) {
                    // Reload counter from WDOGLOAD when INTEN transitions 0->1
                    reload_counter(WatchdogRegisters.WDOGLOAD.WDOG_LOAD.val);
                } 
                else if (old_inten && !inten) {
                    // If INTEN was disabled, cancel timeout event and stop timer
                    timeout_event.cancel();
                    timer_enabled = false;
                }
                
                // Update the register fields in case they were changed by default() 
                this.INTEN.set(inten ? 1 : 0);
                this.RESEN.set(resen ? 1 : 0);
                this.STEP_VALUE.set(step_value);
            }
            // If locked, ignore the write
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGINTCLR {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (!locked) {
                // Clear interrupt and reload counter
                clear_interrupt_and_reload();
            }
            // If locked, ignore the write
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            // Write-only register, always return 0
            return 0;
        }
    }
    
    register WDOGRIS {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGMIS {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            update_masked_interrupt();  // Update before reading
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGLOCK {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            local bool was_locked = locked;
            if (val == 0x1ACCE551) {
                locked = false;
                this.WDOG_LOCK.set(0);  // Return 0 when unlocked
            } else {
                locked = true;
                this.WDOG_LOCK.set(1);  // Return 1 when locked
            }
            
            // Apply to the register field
            default(locked ? 1 : 0, enabled_bytes, aux);
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            // Return 0 when unlocked, 1 when locked
            local uint64 lock_status = locked ? 1 : 0;
            return lock_status;
        }
    }
    
    register WDOGITCR {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (!locked) {
                default(val, enabled_bytes, aux);
                test_mode = ((val & 1) != 0) ? true : false;  // Bit 0 controls test mode
                
                // If exiting test mode, restart normal operation
                if (!test_mode && inten) {
                    reload_counter(WatchdogRegisters.WDOGLOAD.WDOG_LOAD.val);
                } 
                else if (test_mode) {
                    // If entering test mode, cancel any pending timeouts
                    timeout_event.cancel();
                }
            }
            // If locked, ignore the write
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGITOP {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (!locked && test_mode) {
                default(val, enabled_bytes, aux);
                test_output = cast(val, uint32);
                
                // In test mode, directly control outputs based on written values
                if ((val & 0x2) != 0) {  // Bit 1 controls wdogint
                    wdogint.signal.signal_raise();
                } else {
                    wdogint.signal.signal_lower();
                }
                
                if ((val & 0x1) != 0) {  // Bit 0 controls wdogres
                    wdogres.signal.signal_raise();
                } else {
                    wdogres.signal.signal_lower();
                }
            }
            // If locked or not in test mode, ignore the write
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            // Test output registers do not support reading
            return 0;
        }
    }
    
    register WDOGPERIPHID4 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPERIPHID5 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPERIPHID6 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPERIPHID7 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPERIPHID0 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPERIPHID1 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPERIPHID2 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPERIPHID3 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPCELLID0 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPCELLID1 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPCELLID2 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    
    register WDOGPCELLID3 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
}

// Input signal handling
port wclk {
    implement signal {
        method signal_raise() {
            // Work clock - not directly used for timer updates (using lazy evaluation)
        }
        method signal_lower() {
            // Work clock - not directly used for timer updates
        }
    }
}

port wclk_en {
    implement signal {
        method signal_raise() {
            // Work clock enable - not used for timer updates
        }
        method signal_lower() {
            // Work clock disable - not used for timer updates
        }
    }
}

port wrst_n {
    implement signal {
        method signal_raise() {
            // Work reset released - restore normal operation
        }
        method signal_lower() {
            // Work reset asserted - reset device state
            hard_reset();
        }
    }
}

port prst_n {
    implement signal {
        method signal_raise() {
            // APB reset released - restore normal operation
        }
        method signal_lower() {
            // APB reset asserted - reset device state
            hard_reset();
        }
    }
}

// Output signal connections
connect wdogint {
    interface signal;
    method signal_raise() {
        this.signal.signal_raise();
    }
    method signal_lower() {
        this.signal.signal_lower();
    }
}

connect wdogres {
    interface signal;
    method signal_raise() {
        this.signal.signal_raise();
    }
    method signal_lower() {
        this.signal.signal_lower();
    }
}

// Hard reset handler
method hard_reset() {
    // Reset all state variables
    locked = true;
    inten = false;
    resen = false;
    step_value = 0;
    int_pending = false;
    reset_pending = false;
    test_mode = false;
    test_output = 0;
    
    // Reset timer variables
    last_update_time = 0;
    current_counter_value = 0xffffffff;
    timer_enabled = false;
    timer_expired = false;
    
    // Cancel any pending events
    timeout_event.cancel();
    
    // Lower any active signals
    wdogint.signal.signal_lower();
    wdogres.signal.signal_lower();
    
    // Reset register fields to their default values
    WatchdogRegisters.WDOGRIS.RAW_WDOG_INT.set(0);
    update_masked_interrupt();
}

method init() {
    // Initialize with default values
    locked = true;  // Device is locked by default
    inten = false;
    resen = false;
    step_value = 0;
    int_pending = false;
    reset_pending = false;
    test_mode = false;
    test_output = 0;
    
    // Initialize timer state
    last_update_time = 0;
    current_counter_value = 0xffffffff;
    timer_enabled = false;
    timer_expired = false;
}

method post_init() {
    // Check if reset signals are active at initialization
    // Additional post-initialization tasks if needed
}
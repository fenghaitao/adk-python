// Event for timeout detection
event timeout_event is simple_cycle_event {
    method event() {
        // Check if this is second timeout (first timeout already occurred)
        if (raw_int) {
            // Second timeout with RESEN=1: assert wdogres
            if (apb_interface.WDOGCONTROL.RESEN.val == 1) {
                if (!wdogres_asserted) {
                    wdogres.signal_raise();
                    wdogres_asserted = true;
                }
            }
        } else {
            // First timeout: set interrupt status, assert wdogint
            raw_int = true;
            update_outputs();
            
            // Auto-reload counter and reschedule for second timeout
            counter_start_value = cast(apb_interface.WDOGLOAD.val, uint32);
            counter_start_time = SIM_cycle_count(dev.obj);
            schedule_timeout_event();
        }
    }
}

// Calculate step_value divider (÷1, ÷2, ÷4, ÷8, ÷16)
method get_step_value() -> (uint32) {
    local uint32 step_bits = cast((apb_interface.WDOGCONTROL.val >> 2) & 0x7, uint32);
    if (step_bits == 0) return 1;
    if (step_bits == 1) return 2;
    if (step_bits == 2) return 4;
    if (step_bits == 3) return 8;
    if (step_bits == 4) return 16;
    return 1;  // Default to ÷1
}

// Schedule timeout event based on current counter value
method schedule_timeout_event() {
    if (timeout_event.posted())
        timeout_event.remove();
    
    local uint32 inten = cast(apb_interface.WDOGCONTROL.INTEN.val, uint32);
    if (inten == 0)
        return;  // Timer disabled
    
    local uint32 step = get_step_value();
    local uint32 current_value = get_current_counter();
    
    if (current_value == 0)
        return;  // Already expired
    
    local cycles_t cycles_to_zero = cast(current_value, cycles_t) * cast(step, cycles_t);
    timeout_event.post(cycles_to_zero);
}

// Calculate current counter value (lazy evaluation)
method get_current_counter() -> (uint32) {
    local uint32 inten = cast(apb_interface.WDOGCONTROL.INTEN.val, uint32);
    if (inten == 0)
        return counter_start_value;  // Counter frozen when disabled
    
    // Initialize timing on first use (avoid Anti-Pattern #2)
    if (!timer_initialized) {
        counter_start_time = SIM_cycle_count(dev.obj);
        timer_initialized = true;
        return counter_start_value;
    }
    
    local cycles_t now = SIM_cycle_count(dev.obj);
    local cycles_t elapsed = now - counter_start_time;
    local uint32 step = get_step_value();
    local uint32 decremented = cast(elapsed / cast(step, cycles_t), uint32);
    
    if (decremented >= counter_start_value)
        return 0;  // Counter reached zero
    
    return counter_start_value - decremented;
}

// Update wdogint output signal based on WDOGMIS
method update_outputs() {
    local uint32 inten = cast(apb_interface.WDOGCONTROL.INTEN.val, uint32);
    local bool masked_int = raw_int && (inten == 1);
    
    // Check if in integration test mode
    local uint32 itcr = cast(apb_interface.WDOGITCR.val, uint32);
    if ((itcr & 0x1) == 0) {
        // Normal mode: wdogint driven by masked interrupt status
        if (masked_int && !wdogint_asserted) {
            wdogint.signal_raise();
            wdogint_asserted = true;
        } else if (!masked_int && wdogint_asserted) {
            wdogint.signal_lower();
            wdogint_asserted = false;
        }
    }
}

// Reset handling
method hard_reset() {
    // Cancel pending timeout event
    if (timeout_event.posted())
        timeout_event.remove();
    
    // Reset device state
    is_locked = false;
    raw_int = false;
    counter_start_value = 0xFFFFFFFF;
    counter_start_time = 0;
    timer_initialized = false;
    
    // De-assert output signals
    if (wdogint_asserted) {
        wdogint.signal_lower();
        wdogint_asserted = false;
    }
    if (wdogres_asserted) {
        wdogres.signal_lower();
        wdogres_asserted = false;
    }
}


// WARNING: This file is automatically generated from IP-XACT for wdt

dml 1.4;
device wdt;
import "wdt-registers.dml";
import "simics/devs/signal.dml";

// Watchdog timer configuration
param classname = "wdt";
param desc = "ARM PrimeCell Watchdog Timer (SP805)";

// Clock frequency for timing calculations (100 MHz default)
param clock_freq_mhz = 100.0;

// Session state variables for timer operation
saved cycles_t timer_start_time = 0;
saved uint32 timer_start_value = 0;
saved bool timer_enabled = false;
saved bool lock_state = false;  // false = unlocked, true = locked
saved bool test_mode = false;
saved bool raw_interrupt = false;
saved bool reset_asserted = false;

// Event for watchdog timeout
event timeout_event is simple_cycle_event {
    method event() {
        log info: "Watchdog timeout occurred";
        
        if (!raw_interrupt) {
            // First timeout - generate interrupt
            raw_interrupt = true;
            update_interrupt_outputs();
            
            // Reload counter for second timeout if still enabled
            if (timer_enabled) {
                timer_start_value = WatchdogRegisters.WDOGLOAD.WDOG_LOAD.val;
                timer_start_time = SIM_cycle_count(dev.obj);
                schedule_timeout();
            }
        } else {
            // Second timeout - generate reset if enabled
            if (WatchdogRegisters.WDOGCONTROL.RESEN.val == 1) {
                reset_asserted = true;
                update_reset_outputs();
                log info: "Watchdog reset asserted";
            }
        }
    }
}

// Helper methods
method get_step_divider() -> (uint32) {
    local uint32 step_val = WatchdogRegisters.WDOGCONTROL.STEP_VALUE.val;
    switch (step_val) {
        case 0: return 1;
        case 1: return 2;
        case 2: return 4;
        case 3: return 8;
        case 4: return 16;
        default: return 1;  // Invalid values default to ÷1
    }
}

method calculate_current_counter() -> (uint32) {
    if (!timer_enabled) {
        return timer_start_value;
    }
    
    local cycles_t now = SIM_cycle_count(dev.obj);
    local cycles_t elapsed = now - timer_start_time;
    local uint32 divider = get_step_divider();
    local uint32 decremented = cast(elapsed / divider, uint32);
    
    if (decremented >= timer_start_value) {
        return 0;  // Counter has expired
    }
    return timer_start_value - decremented;
}

method schedule_timeout() {
    if (timeout_event.posted()) {
        timeout_event.remove();
    }
    
    if (timer_enabled && timer_start_value > 0) {
        local uint32 divider = get_step_divider();
        local cycles_t cycles_to_zero = timer_start_value * divider;
        timeout_event.post(cycles_to_zero);
    }
}

method update_interrupt_outputs() {
    local bool masked_int = raw_interrupt && (WatchdogRegisters.WDOGCONTROL.INTEN.val == 1);
    
    if (test_mode) {
        // In test mode, outputs controlled by WDOGITOP
        return;
    }
    
    if (masked_int) {
        wdogint.signal_raise();
    } else {
        wdogint.signal_lower();
    }
}

method update_reset_outputs() {
    if (test_mode) {
        // In test mode, outputs controlled by WDOGITOP
        return;
    }
    
    if (reset_asserted) {
        wdogres.signal_raise();
    } else {
        wdogres.signal_lower();
    }
}

method is_locked() -> (bool) {
    return lock_state;
}

// Basic bank declaration is in wdt-registers.dml,
// here is the register implementation with side-effects.
bank WatchdogRegisters is WatchdogRegisters_temp {
    register WDOGLOAD {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (is_locked()) {
                log info: "WDOGLOAD write ignored - device is locked";
                return;
            }
            
            // Call default write behavior first
            default(val, enabled_bytes, aux);
            
            log info: "WDOGLOAD written: 0x%x", val;
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    register WDOGVALUE {
        param configuration = "none";  // Don't checkpoint calculated value
        
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            local uint32 current_value;
            if (timer_enabled) {
                current_value = calculate_current_counter();
            } else {
                // When timer is not enabled, return the start value or default
                if (timer_start_value == 0) {
                    current_value = 0xFFFFFFFF;  // Default value
                } else {
                    current_value = timer_start_value;
                }
            }
            return current_value;
        }
    }
    register WDOGCONTROL {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (is_locked()) {
                log info: "WDOGCONTROL write ignored - device is locked";
                return;
            }
            
            local bool old_inten = (this.INTEN.val == 1);
            
            // Call default write behavior first
            default(val, enabled_bytes, aux);
            
            local bool new_inten = (this.INTEN.val == 1);
            
            // Check for INTEN transition from 0 to 1
            if (!old_inten && new_inten) {
                // Enable timer - reload counter and start
                timer_start_value = WatchdogRegisters.WDOGLOAD.WDOG_LOAD.val;
                timer_start_time = SIM_cycle_count(dev.obj);
                timer_enabled = true;
                raw_interrupt = false;
                reset_asserted = false;
                schedule_timeout();
                log info: "Watchdog timer enabled, loaded with 0x%x", timer_start_value;
            } else if (old_inten && !new_inten) {
                // Disable timer
                timer_enabled = false;
                if (timeout_event.posted()) {
                    timeout_event.remove();
                }
                log info: "Watchdog timer disabled";
            }
            
            update_interrupt_outputs();
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    register WDOGINTCLR {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (is_locked()) {
                log info: "WDOGINTCLR write ignored - device is locked";
                return;
            }
            
            // Clear interrupt and reload counter
            raw_interrupt = false;
            wdogint.signal_lower();
            
            if (timer_enabled) {
                timer_start_value = WatchdogRegisters.WDOGLOAD.WDOG_LOAD.val;
                timer_start_time = SIM_cycle_count(dev.obj);
                schedule_timeout();
                log info: "Interrupt cleared, counter reloaded with 0x%x", timer_start_value;
            }
            
            update_interrupt_outputs();
        }
    }
    register WDOGRIS {
        param configuration = "none";  // Don't checkpoint calculated value
        
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return raw_interrupt ? 1 : 0;
        }
    }
    register WDOGMIS {
        param configuration = "none";  // Don't checkpoint calculated value
        
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            local bool masked_int = raw_interrupt && (WatchdogRegisters.WDOGCONTROL.INTEN.val == 1);
            return masked_int ? 1 : 0;
        }
    }
    register WDOGLOCK {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (val == 0x1ACCE551) {
                lock_state = false;  // Unlock
                log info: "Watchdog unlocked";
            } else {
                lock_state = true;   // Lock
                log info: "Watchdog locked";
            }
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return lock_state ? 1 : 0;
        }
    }
    register WDOGITCR {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (is_locked()) {
                log info: "WDOGITCR write ignored - device is locked";
                return;
            }
            
            local bool old_test_mode = test_mode;
            
            // Call default write behavior first
            default(val, enabled_bytes, aux);
            
            test_mode = (this.INT_TEST_MODE_ENABLE.val == 1);
            
            if (!old_test_mode && test_mode) {
                // Entering test mode - suspend normal operation
                if (timeout_event.posted()) {
                    timeout_event.remove();
                }
                log info: "Integration test mode enabled";
            } else if (old_test_mode && !test_mode) {
                // Exiting test mode - resume normal operation
                if (timer_enabled) {
                    schedule_timeout();
                }
                update_interrupt_outputs();
                update_reset_outputs();
                log info: "Integration test mode disabled";
            }
        }

        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return default(enabled_bytes, aux);
        }
    }
    register WDOGITOP {
        method write_register(uint64 val, uint64 enabled_bytes, void *aux) {
            if (is_locked()) {
                log info: "WDOGITOP write ignored - device is locked";
                return;
            }
            
            if (!test_mode) {
                log info: "WDOGITOP write ignored - not in test mode";
                return;
            }
            
            // In test mode, directly control outputs
            if ((val & 0x2) != 0) {  // WDOGINT_VAL bit
                wdogint.signal_raise();
            } else {
                wdogint.signal_lower();
            }
            
            if ((val & 0x1) != 0) {  // WDOGRES_VAL bit
                wdogres.signal_raise();
            } else {
                wdogres.signal_lower();
            }
            
            log info: "Integration test outputs: INT=%d, RES=%d", 
                ((val & 0x2) != 0) ? 1 : 0, ((val & 0x1) != 0) ? 1 : 0;
        }
    }
    register WDOGPERIPHID4 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x04;
        }
    }
    register WDOGPERIPHID5 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x00;
        }
    }
    register WDOGPERIPHID6 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x00;
        }
    }
    register WDOGPERIPHID7 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x00;
        }
    }
    register WDOGPERIPHID0 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x24;
        }
    }
    register WDOGPERIPHID1 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0xB8;
        }
    }
    register WDOGPERIPHID2 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x1B;
        }
    }
    register WDOGPERIPHID3 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x00;
        }
    }
    register WDOGPCELLID0 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x0D;
        }
    }
    register WDOGPCELLID1 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0xF0;
        }
    }
    register WDOGPCELLID2 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0x05;
        }
    }
    register WDOGPCELLID3 {
        method read_register(uint64 enabled_bytes, void *aux) -> (uint64) {
            return 0xB1;
        }
    }
}


// Reset method to initialize device state
method reset_state() {
    // Reset all state variables
    timer_enabled = false;
    lock_state = false;
    test_mode = false;
    raw_interrupt = false;
    reset_asserted = false;
    timer_start_time = 0;
    timer_start_value = 0;
    
    // Cancel any pending events
    if (timeout_event.posted()) {
        timeout_event.remove();
    }
    
    // Deassert output signals
    wdogint.signal_lower();
    wdogres.signal_lower();
    
    log info: "Watchdog timer reset";
}

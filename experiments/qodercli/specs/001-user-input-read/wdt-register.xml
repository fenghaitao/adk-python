            <ipxact:description>Reserved bits</ipxact:description>
            <ipxact:bitOffset>1</ipxact:bitOffset>
            <ipxact:bitWidth>31</ipxact:bitWidth>
            <ipxact:access>read_only</ipxact:access>
            <ipxact:readAction>modify</ipxact:readAction>
